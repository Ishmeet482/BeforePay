{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "uv sync --frozen --no-dev",
  "functions": {"app/main.py": {
    "maxDuration": 90,
    "excludeFiles": "{.env,.env.*,.venv/**,tests/**,evaluations/**,scripts/**,alembic/**,__pycache__/**,**/__pycache__/**,.pytest_cache/**,.ruff_cache/**,uploads/**,storage/**}"
  }},
  "env": {
    "PUBLIC_DEMO_MODE": "true",
    "DEMO_COOKIE_SECURE": "true",
    "PUBLIC_WEBHOOKS_ENABLED": "false"
  }
}

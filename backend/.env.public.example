# PLACEHOLDERS ONLY. Set in the backend project's secret store, never frontend.
# Use a NEW dedicated synthetic database. Never export the local development DB.
PUBLIC_DEMO_MODE=true
PUBLIC_DEMO_DATABASE=beforepay_demo_2026
DATABASE_URL=postgresql+psycopg://beforepay_runtime:REPLACE_IN_SECRET_STORE@pooler-not-configured.invalid/beforepay_demo_2026?sslmode=require
DEMO_ALLOWED_ORIGINS=["https://frontend-not-configured.invalid"]
DEMO_COOKIE_SECURE=true
DEMO_SESSION_TTL_SECONDS=2592000
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=3
DEMO_AI_CALLS_PER_DAY=0
DEMO_AI_TOKENS_PER_DAY=0
DEMO_AI_TOKENS_PER_MINUTE=0
GEMINI_API_KEY=
PAYPAL_SANDBOX_ENABLED=false
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
PUBLIC_WEBHOOKS_ENABLED=false
# Other resource ceilings retain conservative Phase 2 defaults; see .env.example.
# Vercel injects VERCEL=1. It must never be disabled to evade hosting safeguards.

# Local development only. Match the database/user created by Compose or your DBA.
DATABASE_URL=postgresql+psycopg://contextkey:contextkey_local@127.0.0.1:5433/contextkey
# Sandbox only. Disabled until explicitly configured for manual sandbox testing.
# Use a Sandbox REST app and its Sandbox Business account's merchant/account ID.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_SANDBOX_ENABLED=false
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_MERCHANT_ID=
# Registered Sandbox REST app webhook ID (not client ID). Backend only.
PAYPAL_SANDBOX_WEBHOOK_ID=
# No live API URL or live-mode setting is supported.

# Isolated demo workspace cookies. HTTPS deployments must keep Secure=true.
DEMO_SESSION_TTL_SECONDS=2700
DEMO_COOKIE_SECURE=true
# Exact frontend origins; JSON array, never wildcard or arbitrary previews.
DEMO_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# For explicitly loopback-only HTTP development, opt into DEMO_COOKIE_SECURE=false.
# See docs/demo-sessions.md. Existing legacy bookings remain unassigned/hidden.

# Public backend must explicitly enable this mode. Local sandbox stays unchanged.
# Never expose local-mode backend or use development data in public hosting.
PUBLIC_DEMO_MODE=false
# Public AI is off until an operator verifies the Free Tier allowance and sets
# ALL three shared call/day, token/day and token/minute ceilings below.
DEMO_AI_CALLS_PER_DAY=0
DEMO_AI_TOKENS_PER_DAY=0
DEMO_AI_TOKENS_PER_MINUTE=0
DEMO_AI_CALLS_PER_SESSION=6
DEMO_AI_TOKENS_PER_SESSION=400000
DEMO_AI_CALLS_PER_MINUTE=2
DEMO_AI_CONCURRENT_GLOBAL=1
DEMO_AI_CONCURRENT_SESSION=1
DEMO_AI_COOLDOWN_SECONDS=15
# All-time retained attempt/storage caps, except the rolling session/hour cap.
DEMO_MAX_SESSIONS=100
DEMO_SESSIONS_PER_HOUR=20
DEMO_MAX_BOOKINGS=100
DEMO_BOOKINGS_PER_SESSION=2
DEMO_MAX_SOURCES=400
DEMO_SOURCES_PER_SESSION=8
DEMO_MAX_WRITES=4000
DEMO_WRITES_PER_SESSION=100
DEMO_SOURCE_BYTES=8000000
DEMO_SOURCE_BYTES_PER_SESSION=400000
DEMO_UPLOAD_BYTES=67108864
DEMO_UPLOAD_BYTES_PER_SESSION=6291456
DEMO_PDF_MAX_BYTES=3145728
DEMO_PDF_MAX_PAGES=20
DEMO_SOURCE_MAX_CHARS=40000
# Details, reservation accounting and crash/circuit recovery: docs/public-demo-controls.md

# Backend only. Leave key empty until manually testing extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
